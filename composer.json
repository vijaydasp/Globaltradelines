{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "globaltradelines/cms",
  "type": "project",
  "description": "Global Trade Lines CMS with its original custom administration interface",
  "license": "proprietary",
  "require": {"php": "^8.3", "laravel/framework": "^13.0"},
  "require-dev": {"phpunit/phpunit": "^12.5", "mockery/mockery": "^1.6", "nunomaduro/collision": "^8.8"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}, "files": ["app/Support/helpers.php"]},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": ["@php artisan test"]},
  "config": {"platform": {"php": "8.3.0"}, "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
